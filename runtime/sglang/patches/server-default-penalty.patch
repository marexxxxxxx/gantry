+++ b/sglang/srt/sampling/overthinking_penalty_default.py
@@ -0,0 +1,155 @@
+# Copyright 2026-2026 SGLang Project
+# Licensed under Apache License, Version 2.0
+"""Server-side default overthinking penalty (arXiv 2606.00206).
+
+Builds the dill-serialized ``custom_logit_processor`` payload that is injected
+into every request lacking its own processor when the server runs with
+``--default-overthinking-penalty``. Logic mirrors runtime/sglang/
+overthinking_penalty.py in the deployment repo; this module only differs by
+taking an already-loaded tokenizer instead of a model directory.
+
+The payload COMBINES the overthinking penalty with the stock thinking-budget
+semantics of the fork's Qwen38ThinkingBudgetLogitProcessor so one request can
+use both levers (SGLang allows a single custom_logit_processor per request).
+
+Per-request precedence: request custom_params > server CLI defaults baked into
+the payload at startup.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+logger = __import__("logging").getLogger(__name__)
+
+_THINK_OPEN = "<think>"
+_THINK_CLOSE = "</think>"
+
+# The paper's 50 overthinking markers (Appendix C, Table 8); all leading-space
+# variants. " recheck" splits into 2 tokens on the ~248k vocab and cannot be
+# penalized as a single logit entry.
+MARKERS = [
+    " perhaps", " maybe", " wait", " Wait", " actually", " hold", " Hmm",
+    " hmm", " Alternatively", " alternatively", " However", " however",
+    " instead", " Instead", " But", " but", " though", " although", " yet",
+    " rather", " unless", " otherwise", " nonetheless", " nevertheless",
+    " regardless", " still", " anyway", " Or", " or", " either", " whether",
+    " uncertain", " unsure", " possibly", " might", " could", " another",
+    " different", " reconsider", " rethink", " backtrack", " retry",
+    " revisit", " doubt", " confused", " wrong", " mistake", " error",
+    " incorrect",
+]
+
+
+def resolve_token_ids(tokenizer) -> dict:
+    """Map each marker to ONE token id via encode + decode round-trip check."""
+    resolved: dict = {}
+    skipped: list = []
+    for marker in MARKERS:
+        ids = tokenizer.encode(marker, add_special_tokens=False)
+        if len(ids) == 1 and tokenizer.decode(ids) == marker:
+            resolved[marker] = int(ids[0])
+        else:
+            skipped.append((marker, ids))
+    for marker, ids in skipped:
+        logger.info("overthinking penalty: skipping %r: encodes to %s",
+                    marker, ids)
+    logger.info("overthinking penalty: resolved %d/%d markers",
+                len(resolved), len(MARKERS))
+    if len(resolved) < len(MARKERS) * 0.8:
+        raise ValueError(
+            "fewer than 80% of overthinking markers resolved - wrong model?")
+    return resolved
+
+
+def think_token_ids(tokenizer) -> tuple:
+    """(<think>, </think>, newline) token ids from the tokenizer."""
+    start, end = tokenizer.convert_tokens_to_ids([_THINK_OPEN, _THINK_CLOSE])
+    unk = getattr(tokenizer, "unk_token_id", None)
+    if start is None or end is None or start == unk or end == unk:
+        raise ValueError(
+            f"tokenizer has no {_THINK_OPEN}/{_THINK_CLOSE} tokens - "
+            "think_only penalty mode cannot apply")
+    newline = tokenizer.encode("\n", add_special_tokens=False)
+    if len(newline) != 1:
+        raise ValueError(f"newline is not a single token ({newline})")
+    return int(start), int(end), int(newline[0])
+
+
+def build_overthinking_penalty_payload(
+    tokenizer,
+    default_lambda: float = 2.0,
+    default_think_only: bool = True,
+) -> str:
+    """Build the dill payload for the default overthinking penalty."""
+    from sglang.srt.sampling.custom_logit_processor import (
+        CustomLogitProcessor,
+    )
+
+    token_ids = tuple(sorted(resolve_token_ids(tokenizer).values()))
+    think_start, think_end, newline = think_token_ids(tokenizer)
+
+    # dill serializes this subclass by value; the base class is resolved by
+    # name on the scheduler side, so both processes must run the same SGLang.
+    class OverthinkingPenaltyLogitProcessor(CustomLogitProcessor):
+        PENALTY_TOKEN_IDS = token_ids
+        THINK_START_TOKEN_ID = think_start
+        THINK_END_TOKEN_ID = think_end
+        NEW_LINE_TOKEN_ID = newline
+        DEFAULT_PENALTY_LAMBDA = default_lambda
+        DEFAULT_THINK_ONLY = default_think_only
+
+        def __call__(self, logits, custom_param_list=None):
+            if custom_param_list is None:
+                return logits
+            for i, row_params in enumerate(custom_param_list):
+                params = row_params or {}
+
+                # Request state: inside an OPEN <think> block?
+                req = params.get("__req__")
+                cur_ids = in_open_think = None
+                if req is not None:
+                    cur_ids = [*req.origin_input_ids, *req.output_ids]
+                    in_open_think = (
+                        self.THINK_START_TOKEN_ID in cur_ids
+                        and self.THINK_END_TOKEN_ID not in cur_ids)
+
+                # ---- Part 1: thinking budget (fork semantics) ----
+                budget = params.get("thinking_budget")
+                if (isinstance(budget, int)
+                        and not isinstance(budget, bool)
+                        and budget >= 0
+                        and in_open_think):
+                    start_index = cur_ids.index(self.THINK_START_TOKEN_ID)
+                    num_after_start = len(cur_ids) - start_index - 1
+                    if num_after_start >= budget:
+                        if (not req.output_ids or req.output_ids[-1]
+                                != self.NEW_LINE_TOKEN_ID):
+                            # Step A: force a newline before closing.
+                            logits[i, :] = -float("inf")
+                            logits[i, self.NEW_LINE_TOKEN_ID] = 0.0
+                        else:
+                            # Step B: force </think>.
+                            logits[i, :] = -float("inf")
+                            logits[i, self.THINK_END_TOKEN_ID] = 0.0
+                        continue  # row fully masked; penalty moot
+
+                # ---- Part 2: overthinking penalty (paper Eq. 1) ----
+                lam = params.get("penalty_lambda",
+                                 self.DEFAULT_PENALTY_LAMBDA)
+                try:
+                    lam = float(lam)
+                except (TypeError, ValueError):
+                    continue
+                if lam == 0.0:
+                    continue
+                if params.get("think_only", self.DEFAULT_THINK_ONLY):
+                    if in_open_think is False:
+                        continue
+                    # in_open_think True, or None when no __req__ was sent
+                    # (custom_params omitted) -> degrade to always-on penalty
+                    # instead of silently dropping the row.
+                logits[i, self.PENALTY_TOKEN_IDS] -= lam
+            return logits
+
+    return OverthinkingPenaltyLogitProcessor.to_str()
