[Unit]
Description=aiserver-monitor gateway (OpenAI passthrough + dashboard)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/user/small_qwen/aiserver-monitor
Environment=AISERVER_MONITOR_LISTEN_PORT=30000
Environment=AISERVER_MONITOR_UPSTREAM_BASE=http://127.0.0.1:30001
Environment=AISERVER_MONITOR_EMBED_BASE=http://127.0.0.1:30002
Environment=AISERVER_MONITOR_AUDIO_BASE=http://127.0.0.1:30003
Environment=AISERVER_MONITOR_CHATTERBOX_BASE=http://127.0.0.1:30004
# CPU-Embedding-Sidecar gehoert zum Gateway; '-' ignoriert Fehler, damit ein
# Embedding-Problem den Chat-Betrieb nicht blockiert.
ExecStartPre=-/home/user/small_qwen/runtime/embed/start-embed.sh
# Audio-Sidecar (Whisper/Piper) ebenso; Audio darf den Chat nie blockieren.
ExecStartPre=-/home/user/small_qwen/runtime/audio/start-audio.sh
ExecStartPre=-/home/user/small_qwen/runtime/chatterbox/start-chatterbox.sh
ExecStopPost=-/home/user/small_qwen/runtime/embed/stop-embed.sh
ExecStopPost=-/home/user/small_qwen/runtime/audio/stop-audio.sh
ExecStopPost=-/home/user/small_qwen/runtime/chatterbox/stop-chatterbox.sh
ExecStart=/home/user/small_qwen/.venv/bin/python -m aiserver_monitor
Restart=always
RestartSec=3
# Offene Client-Verbindungen (SSE/Streams) koennen den uvicorn-Shutdown
# aufhalten; nach 15 s greift SIGKILL. SIGKILL gilt dabei als sauber.
TimeoutStopSec=15
SuccessExitStatus=SIGKILL

[Install]
WantedBy=default.target
